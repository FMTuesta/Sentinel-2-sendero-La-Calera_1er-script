
// ======================================================
// SENTINEL-2: SD DE INDICES POR SECTOR Y FECHA EXACTA
// 19 fechas especificas
// 52 sectores por fecha
// Sin ventana temporal +/- dias
// Incluye conteo de pixeles validos por indice
// ======================================================


// ------------------------------------------------------
// 1. SECTORES
// ------------------------------------------------------

var sectores = ee.FeatureCollection(
  'projects/ee-fernandatuesta/assets/sendero30x10m_52s'
);

print('Cantidad de sectores:', sectores.size());

Map.addLayer(sectores, {}, 'Sectores');
Map.centerObject(sectores);


// ------------------------------------------------------
// 2. FECHAS EXACTAS
// ------------------------------------------------------

var fechas = [
  '2023-10-04',
  '2023-10-09',
  '2023-11-08',
  '2023-12-10',
  '2024-01-04',
  '2024-01-27',
  '2024-03-12',
  '2024-03-29',
  '2024-04-18',
  '2024-05-11',
  '2024-06-10',
  '2024-07-17',
  '2024-08-14',
  '2024-09-20',
  '2024-10-03',
  '2024-10-25',
  '2024-11-09',
  '2024-12-09',
  '2024-12-27'
];


// ------------------------------------------------------
// 3. COLECCION SENTINEL-2
// ------------------------------------------------------

var S2 = ee.ImageCollection(
  'COPERNICUS/S2_SR_HARMONIZED'
);


// ------------------------------------------------------
// 4. CALCULAR INDICES CON MASCARA
// ------------------------------------------------------

function prepararIndices(image) {

  var scl = image.select('SCL');

  // Excluir sin datos, pixeles defectuosos,
  // sombras de nubes, nubes y cirros.
  var mascara = scl.neq(0)
    .and(scl.neq(1))
    .and(scl.neq(3))
    .and(scl.neq(8))
    .and(scl.neq(9))
    .and(scl.neq(10));

  var limpia = image.updateMask(mascara);

  // Reflectancia escalada entre 0 y 1
  var nir = limpia.select('B8').multiply(0.0001);
  var red = limpia.select('B4').multiply(0.0001);
  var blue = limpia.select('B2').multiply(0.0001);
  var swir = limpia.select('B11').multiply(0.0001);

  // NDVI
  var NDVI = nir.subtract(red)
    .divide(nir.add(red))
    .updateMask(nir.add(red).neq(0))
    .rename('NDVI');

  // SAVI (L = 0.5)
  var SAVI = nir.subtract(red)
    .multiply(1.5)
    .divide(nir.add(red).add(0.5))
    .rename('SAVI');

  // EVI
  var denominadorEVI = nir
    .add(red.multiply(6))
    .subtract(blue.multiply(7.5))
    .add(1);

  var EVI = nir.subtract(red)
    .multiply(2.5)
    .divide(denominadorEVI)
    .updateMask(denominadorEVI.neq(0))
    .rename('EVI');

  // NDMI
  var denominadorNDMI = nir.add(swir);

  var NDMI = nir.subtract(swir)
    .divide(denominadorNDMI)
    .updateMask(denominadorNDMI.neq(0))
    .rename('NDMI');

  // MSI
  var MSI = swir.divide(nir)
    .updateMask(nir.neq(0))
    .rename('MSI');

  return ee.Image.cat([
    NDVI, SAVI, EVI, NDMI, MSI
  ]).copyProperties(image, image.propertyNames());
}


// ------------------------------------------------------
// 5. CREAR UNA FILA POR SECTOR Y FECHA
// ------------------------------------------------------

function procesarFecha(fechaTexto) {

  var fecha = ee.Date(fechaTexto);
  var fin = fecha.advance(1, 'day');

  // Solo imagenes adquiridas en la fecha exacta.
  var coleccion = S2
    .filterDate(fecha, fin)
    .filterBounds(sectores);

  var cantidadImagenes = coleccion.size();

  print(
    'Imagenes para la fecha exacta ' + fechaTexto,
    cantidadImagenes
  );

  // Si hay varias imagenes ese dia, seleccionar
  // la de menor porcentaje de nubosidad global.
  var imagen = ee.Image(
    coleccion.sort('CLOUDY_PIXEL_PERCENTAGE').first()
  );

  // Si no hay imagen, crear una imagen completamente
  // enmascarada para conservar las 52 filas.
  var imagenVacia = ee.Image.constant([
    0, 0, 0, 0, 0
  ]).rename([
    'NDVI', 'SAVI', 'EVI', 'NDMI', 'MSI'
  ]).updateMask(ee.Image.constant(0));

  var indices = ee.Image(ee.Algorithms.If(
    cantidadImagenes.gt(0),
    prepararIndices(imagen),
    imagenVacia
  ));

  // Combinar SD y conteo para cada banda.
  var reductor = ee.Reducer.stdDev().combine({
    reducer2: ee.Reducer.count(),
    sharedInputs: true
  });

  var extraidos = indices.reduceRegions({
    collection: sectores,
    reducer: reductor,
    scale: 10,
    tileScale: 2
  });

  // Garantizar una fila por cada geometria.
  return extraidos.map(function(feature) {

    var sector = feature.get('Sector');

    var tieneImagen = cantidadImagenes.gt(0);

    return feature.set({

      'Sector_fecha': ee.String(sector)
        .cat('_')
        .cat(fechaTexto),

      'fecha_muestreo': fechaTexto,

      'fecha_imagen': ee.Algorithms.If(
        tieneImagen,
        imagen.date().format('YYYY-MM-dd'),
        null
      ),

      'hay_imagen': tieneImagen

    });

  });
}


// ------------------------------------------------------
// 6. PROCESAR LAS 19 FECHAS
// ------------------------------------------------------

var resultados = ee.FeatureCollection(
  fechas.map(procesarFecha)
).flatten();


// ------------------------------------------------------
// 7. ORDENAR Y VERIFICAR
// ------------------------------------------------------

resultados = resultados
  .sort('fecha_muestreo')
  .sort('Sector');

print('Resultados:', resultados);

print(
  'Total de filas (esperado: 988 si hay 52 sectores):',
  resultados.size()
);

print(
  'Primer registro:',
  resultados.first()
);


// ------------------------------------------------------
// 8. EXPORTAR CSV
// ------------------------------------------------------

var columnasCSV = [
  'Sector',
  'Sector_fecha',
  'fecha_muestreo',
  'fecha_imagen',
  'hay_imagen',

  'NDVI_stdDev',
  'NDVI_count',

  'SAVI_stdDev',
  'SAVI_count',

  'EVI_stdDev',
  'EVI_count',

  'NDMI_stdDev',
  'NDMI_count',

  'MSI_stdDev',
  'MSI_count'
];

Export.table.toDrive({
  collection: resultados.select(columnasCSV),
  description: 'Sentinel2_SD_indices_52sectores_fechas_exactas',
  fileFormat: 'CSV',
  selectors: columnasCSV
});
