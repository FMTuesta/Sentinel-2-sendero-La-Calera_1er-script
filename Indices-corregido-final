// 3. COLECCION SENTINEL-2
// ------------------------------------------------------

var S2 = ee.ImageCollection(
  'COPERNICUS/S2_SR_HARMONIZED'
);


// ------------------------------------------------------
// 4. CALCULAR NDVI, SAVI, EVI, NDMI Y MSI
// ------------------------------------------------------

function calcularIndices(image) {

  // NDVI: verdor de la vegetacion
  var NDVI = image.normalizedDifference([
    'B8',
    'B4'
  ]).rename('NDVI');


  // --------------------------------------------------
  // REFLECTANCIA: ESCALA DE 0 A 1
  // Sentinel-2 SR almacena reflectancia multiplicada
  // por 10000. Se corrige para SAVI y EVI.
  // --------------------------------------------------

  var NIR = image.select('B8').multiply(0.0001);
  var RED = image.select('B4').multiply(0.0001);
  var BLUE = image.select('B2').multiply(0.0001);


  // SAVI: indice ajustado por el suelo (L = 0.5)
  var SAVI = NIR.subtract(RED)
    .multiply(1.5)
    .divide(
      NIR.add(RED).add(0.5)
    )
    .rename('SAVI');


  // EVI: indice de vegetacion mejorado
  var EVI = NIR.subtract(RED)
    .multiply(2.5)
    .divide(
      NIR
        .add(RED.multiply(6))
        .subtract(BLUE.multiply(7.5))
        .add(1)
    )
    .rename('EVI');


  // NDMI: indice de humedad de la vegetacion
  // El factor de escala se cancela en el cociente.
  var NDMI = image.normalizedDifference([
    'B8',
    'B11'
  ]).rename('NDMI');


  // MSI: indice de estres hidrico
  // Valores altos suelen indicar menor contenido de agua.
  // El factor de escala se cancela en el cociente.
  var MSI = image.select('B11')
    .divide(image.select('B8'))
    .rename('MSI');


  // Agregar los cinco indices a la imagen
  return image.addBands([
    NDVI,
    SAVI,
    EVI,
    NDMI,
    MSI
  ]);
}


// ------------------------------------------------------
// 5. NUBOSIDAD, SOMBRA E INDICES POR SECTOR
// ------------------------------------------------------

function datosPorSector(image, fechaMuestreo) {

  // Calcular indices sin enmascarar nubes ni sombras
  image = calcularIndices(image);

  // Clasificacion SCL de Sentinel-2
  var scl = image.select('SCL');

  // Nubes: clases 8, 9 y 10
  var nube = scl.eq(8)
    .or(scl.eq(9))
    .or(scl.eq(10))
    .rename('nube');

  // Sombra de nubes: clase 3
  var sombra = scl.eq(3)
    .rename('sombra');

  // Bandas que se van a extraer
  var imagenExtraccion = image.select([
    'NDVI',
    'SAVI',
    'EVI',
    'NDMI',
    'MSI'
  ]).addBands([
    nube,
    sombra
  ]);

  // Promedio por sector
  var datos = imagenExtraccion.reduceRegions({
    collection: sectores,
    reducer: ee.Reducer.mean(),
    scale: 10
  });

  // Agregar metadatos de la imagen
  return datos.map(function(feature) {

    var fechaImagen = image.date();

    // La propiedad del sector se llama "Sector"
    var sector = feature.get('Sector');


    // --------------------------------------------------
    // PORCENTAJES DE NUBE Y SOMBRA
    // Conservar 0 cuando no hay nubes/sombras.
    // Conservar null cuando no hay datos validos.
    // --------------------------------------------------

    var valorNube = feature.get('nube');

    var porcentajeNube = ee.Algorithms.If(
      ee.Algorithms.IsEqual(valorNube, null),
      null,
      ee.Number(valorNube).multiply(100)
    );

    var valorSombra = feature.get('sombra');

    var porcentajeSombra = ee.Algorithms.If(
      ee.Algorithms.IsEqual(valorSombra, null),
      null,
      ee.Number(valorSombra).multiply(100)
    );


    return feature.set({
      'Sector': sector,

      'Sector_fecha': ee.Algorithms.If(
        ee.Algorithms.IsEqual(sector, null),
        null,
        ee.String(sector)
          .cat('_')
          .cat(fechaMuestreo)
      ),

      'diferencia_dias': fechaImagen.difference(
        ee.Date(fechaMuestreo),
        'day'
      ),

      'fecha_imagen': fechaImagen.format(
        'YYYY-MM-dd'
      ),

      'fecha_muestreo': fechaMuestreo,

      'hora_UTC': fechaImagen.format(
        'HH:mm:ss',
        'UTC'
      ),

      'hora_local': fechaImagen
        .advance(-3, 'hour')
        .format('HH:mm:ss', 'UTC'),

      'porcentaje_nube_sector': porcentajeNube,

      'porcentaje_sombra_sector': porcentajeSombra
    });

  });
}


// ------------------------------------------------------
// 6. BUSCAR IMAGENES +/- 5 DIAS
// ------------------------------------------------------

function buscarFecha(fechaTexto) {

  var fecha = ee.Date(fechaTexto);

  var inicio = fecha.advance(-5, 'day');

  // El limite superior de filterDate es exclusivo.
  // Con +6 se incluye el dia que corresponde a +5.
  var fin = fecha.advance(6, 'day');

  var coleccion = S2
    .filterDate(inicio, fin)
    .filterBounds(sectores);

  print(
    'Cantidad de imagenes para ' + fechaTexto,
    coleccion.size()
  );

  return coleccion.map(function(image) {

    return datosPorSector(
      image,
      fechaTexto
    );

  }).flatten();
}


// ------------------------------------------------------
// 7. APLICAR A TODAS LAS FECHAS
// ------------------------------------------------------

var resultados = ee.FeatureCollection(
  fechas.map(buscarFecha)
).flatten();


// ------------------------------------------------------
// 8. ORDENAR RESULTADOS
// ------------------------------------------------------

resultados = resultados.sort('fecha_muestreo');


