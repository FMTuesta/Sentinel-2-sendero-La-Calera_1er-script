
// ======================================================
// SENTINEL-2: NUBOSIDAD + INDICES POR SECTOR
// Todas las imagenes disponibles +/- 5 dias
// Solo NDVI, SAVI y EVI
// ======================================================


// ------------------------------------------------------
// 1. SECTORES
// ------------------------------------------------------

var sectores = ee.FeatureCollection(
  'projects/ee-fernandatuesta/assets/sendero30x10m_52s'
);

print('Primer sector:', sectores.first());
print('Lista de propiedades:', sectores.first().propertyNames());

Map.addLayer(sectores, {}, 'Sectores');
Map.centerObject(sectores);


// ------------------------------------------------------
// 2. FECHAS DE MUESTREO
// ------------------------------------------------------

var fechas = [
  '2023-10-04',
  '2023-10-09',
  '2023-11-11',
  '2023-12-11',
  '2024-01-05',
  '2024-01-26',
  '2024-03-07',
  '2024-03-29',
  '2024-04-18',
  '2024-05-10',
  '2024-06-06',
  '2024-07-18',
  '2024-08-15',
  '2024-09-24',
  '2024-10-03',
  '2024-10-26',
  '2024-11-09',
  '2024-12-09',
  '2024-12-27'
];


// ------------------------------------------------------
// 3. COLECCION SENTINEL-2
// ------------------------------------------------------

var S2 = ee.ImageCollection(
  'COPERNICUS/S2_SR_HARMONIZED'
);


// ------------------------------------------------------
// 4. CALCULAR SOLO NDVI, SAVI Y EVI
// ------------------------------------------------------

function calcularIndices(image) {

  // NDVI
  var NDVI = image.normalizedDifference([
    'B8',
    'B4'
  ]).rename('NDVI');

  // SAVI, con L = 0.5
  var SAVI = image.expression(
    '1.5 * ((NIR - RED) / (NIR + RED + 0.5))',
    {
      NIR: image.select('B8'),
      RED: image.select('B4')
    }
  ).rename('SAVI');

  // EVI
  var EVI = image.expression(
    '2.5 * ((NIR - RED) / (NIR + 6 * RED - 7.5 * BLUE + 1))',
    {
      NIR: image.select('B8'),
      RED: image.select('B4'),
      BLUE: image.select('B2')
    }
  ).rename('EVI');

  return image.addBands([
    NDVI,
    SAVI,
    EVI
  ]);
}


// ------------------------------------------------------
// 5. NUBOSIDAD, SOMBRA E INDICES POR SECTOR
// ------------------------------------------------------

function datosPorSector(image, fechaMuestreo) {

  // Calcular indices
  image = calcularIndices(image);

  // Clasificacion SCL de Sentinel-2
  var scl = image.select('SCL');

  // Nubes: clases 8, 9 y 10
  var nube = scl.eq(8)
    .or(scl.eq(9))
    .or(scl.eq(10))
    .rename('nube');

  // Sombra de nubes: clase 3
  var sombra = scl.eq(3)
    .rename('sombra');

  // Bandas que se van a extraer
  var imagenExtraccion = image.select([
    'NDVI',
    'SAVI',
    'EVI'
  ]).addBands([
    nube,
    sombra
  ]);

  // Promedio por sector
  var datos = imagenExtraccion.reduceRegions({
    collection: sectores,
    reducer: ee.Reducer.mean(),
    scale: 10
  });

  // Agregar metadatos de la imagen
  return datos.map(function(feature) {

    var fechaImagen = image.date();

    // La propiedad del sector debe llamarse "Sector"
    var sector = feature.get('Sector');

    // Porcentajes de pixeles clasificados como nube y sombra
    var porcentajeNube = ee.Algorithms.If(
      feature.get('nube'),
      ee.Number(feature.get('nube')).multiply(100),
      null
    );

    var porcentajeSombra = ee.Algorithms.If(
      feature.get('sombra'),
      ee.Number(feature.get('sombra')).multiply(100),
      null
    );

    return feature.set({
      'Sector': sector,

      'Sector_fecha': ee.Algorithms.If(
        ee.Algorithms.IsEqual(sector, null),
        null,
        ee.String(sector)
          .cat('_')
          .cat(fechaMuestreo)
      ),

      'diferencia_dias': fechaImagen.difference(
        ee.Date(fechaMuestreo),
        'day'
      ),

      'fecha_imagen': fechaImagen.format(
        'YYYY-MM-dd'
      ),

      'fecha_muestreo': fechaMuestreo,

      'hora_UTC': fechaImagen.format(
        'HH:mm:ss',
        'UTC'
      ),

      'hora_local': fechaImagen
        .advance(-3, 'hour')
        .format('HH:mm:ss', 'UTC'),

      'porcentaje_nube_sector': porcentajeNube,

      'porcentaje_sombra_sector': porcentajeSombra
    });

  });
}


// ------------------------------------------------------
// 6. BUSCAR IMAGENES +/- 5 DIAS
// ------------------------------------------------------

function buscarFecha(fechaTexto) {

  var fecha = ee.Date(fechaTexto);

  var inicio = fecha.advance(-5, 'day');

  // El limite superior de filterDate es exclusivo.
  // Con +6 se incluye el dia que corresponde a +5.
  var fin = fecha.advance(6, 'day');

  var coleccion = S2
    .filterDate(inicio, fin)
    .filterBounds(sectores);

  print(
    'Cantidad de imagenes para ' + fechaTexto,
    coleccion.size()
  );

  return coleccion.map(function(image) {

    return datosPorSector(
      image,
      fechaTexto
    );

  }).flatten();
}


// ------------------------------------------------------
// 7. APLICAR A TODAS LAS FECHAS
// ------------------------------------------------------

var resultados = ee.FeatureCollection(
  fechas.map(buscarFecha)
).flatten();


// ------------------------------------------------------
// 8. ORDENAR RESULTADOS
// ------------------------------------------------------

resultados = resultados.sort('fecha_muestreo');


// ------------------------------------------------------
// 9. MOSTRAR RESULTADOS
// ------------------------------------------------------

print(
  'Sentinel-2: indices y nubosidad por sector',
  resultados
);

print(
  'Cantidad total de registros',
  resultados.size()
);

print(
  'Propiedades del primer resultado:',
  resultados.first().propertyNames()
);


